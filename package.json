    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
