{
  "name": "agent-agent-hr-browser-extension",
  "version": "0.3.11",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.auth-sync.config.ts",
