{
  "name": "agent-agent-hr-extension",
  "version": "0.6.64",
  "description": "BOSS agent 工具扩展与网申填写扩展的独立源码仓库",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-extensions.mjs",
    "build:local": "node scripts/build-local.mjs",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:userscript && npm run typecheck:boss && npm run typecheck:autofill",
    "test": "vitest run",
    "tool": "node scripts/tool.mjs",
    "dev:serve": "node scripts/dev-serve.mjs",
    "build:boss": "node scripts/build-extensions.mjs boss-agent",
    "build:autofill": "node scripts/build-extensions.mjs application-autofill",
    "build:userscript": "vite build",
    "typecheck:userscript": "vue-tsc --noEmit --project tsconfig.check.json",
    "typecheck:boss": "tsc --noEmit --project apps/boss-agent/tsconfig.json",
    "typecheck:autofill": "npm --prefix apps/application-autofill run typecheck",
    "test:userscript": "vitest run",
    "test:autofill": "npm --prefix apps/application-autofill test",
    "check:artifacts": "node scripts/check-extension-artifacts.mjs",
    "package": "node scripts/package-extensions.mjs",
    "package:boss": "node scripts/package-extensions.mjs boss-agent",
    "package:autofill": "node scripts/package-extensions.mjs application-autofill",
    "test:boss": "vitest run --config apps/boss-agent/vitest.config.ts"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-monkey": "^4.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0",
    "@types/chrome": "^0.1.33"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
